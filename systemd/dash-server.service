[Unit]
Description=Dash server (serves dash_ui)

[Service]
Type=simple
WorkingDirectory=/home/beegor/crankProject/node_server
ExecStart=/usr/bin/node server.cjs
Restart=on-failure
RestartSec=2
Environment=NODE_ENV=production
StandardOutput=append:~/dash_server.log
StandardError=append:~/dash_server.log

[Install]
WantedBy=multi-user.target