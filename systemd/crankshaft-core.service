[Unit]
Description=Crankshaft core (Android Auto session/protocol daemon)
Requires=crankshaft-pulseaudio.service
After=network.target bluetooth.target crankshaft-pulseaudio.service

[Service]
Type=simple
# TODO: adjust to your actual build output path
ExecStart=/home/beegor/crankProject/crankshaft-core/build-release/core/crankshaft-core
WorkingDirectory=/home/beegor/crankProject/crankshaft-core
Restart=on-failure
RestartSec=2
User=beegor
Environment=XDG_RUNTIME_DIR=/run/crankshaft
Environment=PULSE_SERVER=unix:/run/crankshaft/pulse/native
Environment=PIPEWIRE_RUNTIME_DIR=/run/crankshaft

[Install]
WantedBy=multi-user.target