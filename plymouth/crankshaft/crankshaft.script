# Crankshaft Plymouth boot theme
# Expects logo.png in this theme directory

Window.SetBackgroundTopColor(0.05, 0.05, 0.06);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_width / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen_height / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetZ(10);

# --- pulsing progress dots under the logo ---
dot_count = 5;
dot_spacing = 22;
dots_total_width = dot_spacing * (dot_count - 1);
dots = [];

for (i = 0; i < dot_count; i++) {
  dots[i].image = Image.Text("•", 1, 1, 1, 1, "Sans 28");
  dots[i].sprite = Sprite(dots[i].image);
  dots[i].sprite.SetX(screen_width / 2 - dots_total_width / 2 + i * dot_spacing);
  dots[i].sprite.SetY(logo.sprite.GetY() + logo.image.GetHeight() + 40);
  dots[i].sprite.SetZ(10);
}

progress_time = 0;

fun refresh_callback() {
  progress_time++;
  active = Math.Int(progress_time / 6) % dot_count;
  for (i = 0; i < dot_count; i++) {
    if (i == active) {
      dots[i].sprite.SetOpacity(1.0);
    } else {
      dots[i].sprite.SetOpacity(0.3);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);